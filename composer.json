{
    "name": "maxitsa/app",
    "description": "Application Max It SA",
    "autoload": {
        "psr-4": {
            "App\\Core\\": "app/core/",
            "App\\Controller\\": "src/controller/",
            "App\\Service\\": "src/service/",
            "App\\Repository\\": "src/repository/",
            "App\\Entity\\": "src/entity/"
        }
    },
    "authors": [
        {
            "name": "Papa Sidy Fall",
            "email": "papasidyfall03@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.6",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
